<Window x:Class="Swapper.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Swapper.App"
        xmlns:ui="clr-namespace:Studio.Ui;assembly=Studio.Ui"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Swapper Preview" Width="1100" Height="820" MinWidth="560" MinHeight="420"
        Background="{StaticResource Paper}" Icon="pack://application:,,,/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- the 3D preview on its own (resizable; closing it puts the preview back in the main window) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- slim brand band = the title bar (Studio.Ui) -->
        <DockPanel Background="{StaticResource Purple}" Height="44" LastChildFill="False">
            <local:Tracked DockPanel.Dock="Left" Text="Swapper · Preview" Margin="18,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="11" Tracking="0.16" Foreground="{StaticResource Paper}"/>
            <ui:CaptionButtons DockPanel.Dock="Right"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="18,14,18,18">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                <local:Tracked Style="{StaticResource Label}" Text="Preview" Margin="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <Border Background="#111111" BorderBrush="#2B2140" BorderThickness="1">
                <wv2:WebView2 x:Name="View" DefaultBackgroundColor="#111111" AutomationProperties.AutomationId="PreviewWindowView"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
