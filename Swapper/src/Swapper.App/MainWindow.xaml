<Window x:Class="Swapper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Swapper.App"
        xmlns:ui="clr-namespace:Studio.Ui;assembly=Studio.Ui"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Swapper" Height="1000" Width="940" MinHeight="560" MinWidth="720"
        Background="{StaticResource Paper}" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- brand band -->
        <DockPanel Background="{StaticResource Purple}" Height="64" LastChildFill="False">
            <Image DockPanel.Dock="Left" Source="{StaticResource Wordmark}" Height="20" Margin="26,0,0,0" VerticalAlignment="Center"/>
            <!-- the band is the title bar (Studio.Ui): window buttons at its right end -->
            <ui:CaptionButtons DockPanel.Dock="Right"/>
            <local:Tracked DockPanel.Dock="Right" Text="Swapper" Margin="0,0,18,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="12" Tracking="0.16" Foreground="{StaticResource Paper}"/>
        </DockPanel>

        <Grid x:Name="Body" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FormCol" Width="940" MinWidth="660"/>
            <ColumnDefinition x:Name="SplitCol" Width="12"/>
            <ColumnDefinition x:Name="PreviewCol" Width="*" MinWidth="420"/>
        </Grid.ColumnDefinitions>
        <!-- the picks: they scroll when the window is too short for them (the log keeps at least its minimum) -->
        <ScrollViewer x:Name="FormScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>
            </ScrollViewer.Resources>
        <Grid x:Name="FormGrid" Margin="26,20,16,22" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="64"/>
            </Grid.RowDefinitions>

            <!-- the faded "26" from the RM Designs posts (drawn first, so everything sits on top of it) -->
            <TextBlock Grid.Row="0" Grid.RowSpan="3" Text="26" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="132"
                       Foreground="{StaticResource Purple}" Opacity="0.07" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,-26,-4,0" IsHitTestVisible="False"/>

            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <local:Tracked Text="Swapper" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="22" Tracking="0.1" VerticalAlignment="Center"/>
                    <!-- version: purple box, white Roboto Mono Bold (as in the other Studio apps) -->
                    <Border Background="{StaticResource Purple}" Padding="10,4,10,5" Margin="16,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="Version">
                        <TextBlock x:Name="VersionText" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Paper}"/>
                    </Border>
                    <Button x:Name="AboutButton" Margin="14,0,0,0" Height="28" Padding="10,0" Content="About" Click="About_Click" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AboutButton" ToolTip="Credits and licence"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                           Text="*chassis, steering wheel, rims, engine sound and suits into a serps template · pick any of the five · the file you open is never changed"
                           ToolTip="Tip: drop a .serps template onto this window to open it."/>
            </StackPanel>
            <Border Grid.Row="1" Height="1" Background="{StaticResource Purple}" Margin="0,14,0,12"/>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <local:Tracked Style="{StaticResource Label}" Text="F1 25 game folder"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Detect" Click="Detect_Click"/>
                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseGame_Click"/>
                    <TextBox x:Name="GameBox" LostFocus="GameBox_LostFocus"/>
                </DockPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <DockPanel Margin="0,0,0,7">
                    <local:Tracked Style="{StaticResource Label}" Text="SERPs template" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TemplateHint" Style="{StaticResource Sub}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseTemplate_Click"/>
                    <TextBox x:Name="TemplateBox" IsReadOnly="True"/>
                </DockPanel>
            </StackPanel>

            <!-- the template's chassis options: ticked ones get the new steering wheel -->
            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <DockPanel Margin="0,0,0,7">
                    <local:Tracked Style="{StaticResource Label}" Text="Chassis options" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EntryNote" Style="{StaticResource Sub}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="each ticked option gets a new section with the new wheel · the options themselves are kept as they are"/>
                </DockPanel>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,2" MinHeight="44">
                    <StackPanel>
                    <Grid>
                        <ItemsControl x:Name="EntryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,8" ToolTip="{Binding Tooltip}">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                                  AutomationProperties.Name="{Binding Label}">
                                            <DockPanel LastChildFill="True">
                                                <local:Tracked DockPanel.Dock="Left" Text="{Binding Title}" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="11" Tracking="0.1"/>
                                                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding Brush}" Padding="6,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <local:Tracked Text="{Binding Text}" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="8.5"
                                                                               Tracking="0.14" Foreground="{StaticResource Ink}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Muted}"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                            </DockPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EntryHint" Style="{StaticResource Sub}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,12"
                                   Text="open a template or project to list its chassis options."/>
                    </Grid>
                    <!-- a chassis picked from the game: an option added beside the template's own (never in place of one) -->
                    <Border x:Name="NewOptionRow" Padding="0,8" Visibility="Collapsed" Opacity="0.75" AutomationProperties.AutomationId="NewOptionRow"
                            ToolTip="The new chassis is added as one more chassis option when you build; your chassis options are kept as they are">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="+" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="13" Foreground="{StaticResource Purple}"
                                       Width="22" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            <local:Tracked x:Name="NewOptionTitle" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource Purple}"
                                           FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="11" Tracking="0.1"/>
                            <Border DockPanel.Dock="Left" Background="{StaticResource Teal}" Padding="6,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <local:Tracked Text="New option" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="8.5" Tracking="0.14" Foreground="{StaticResource Ink}"/>
                            </Border>
                            <TextBlock Text="added when you build · your options are kept" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="11"
                                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </DockPanel>
                    </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- the five picks: one slot each, saying whose it is (a donor picked below, or the template's own); click a slot to
                 pick for it in the list below. All one width (the longest title's), beside the label, wrapping under the first
                 when the column is narrow -->
            <StackPanel Grid.Row="5" Margin="0,2,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <local:Tracked Style="{StaticResource Label}" Text="Swap" Margin="0,20,18,3" VerticalAlignment="Top"/>
                    <WrapPanel x:Name="SlotPanel" Grid.Column="1"/>
                </Grid>
                <TextBlock x:Name="SlotHint" Style="{StaticResource Sub}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="0,0,0,10">
                <DockPanel Margin="0,0,0,7">
                    <StackPanel x:Name="YearTabs" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="YAll" Style="{StaticResource SeriesTab}" Tag="{StaticResource Purple}" Margin="0,0,-1,0" GroupName="Year" Content="All" Checked="Tab_Changed" AutomationProperties.Name="Donors: all seasons"/>
                        <RadioButton x:Name="Y2026" Style="{StaticResource SeriesTab}" Tag="{StaticResource Purple}" Margin="0,0,-1,0" GroupName="Year" Content="2026" IsChecked="True" Checked="Tab_Changed" AutomationProperties.Name="Donors: 2026"/>
                        <RadioButton x:Name="Y2025" Style="{StaticResource SeriesTab}" Tag="{StaticResource Purple}" Margin="0,0,-1,0" GroupName="Year" Content="2025" Checked="Tab_Changed" AutomationProperties.Name="Donors: 2025"/>
                        <RadioButton x:Name="Y2024" Style="{StaticResource SeriesTab}" Tag="{StaticResource Purple}" Margin="0,0,0,0" GroupName="Year" Content="2024" Checked="Tab_Changed" AutomationProperties.Name="Donors: 2024"/>
                        <StackPanel x:Name="SeriesTabs" Orientation="Horizontal" Margin="14,0,0,0">
                            <RadioButton x:Name="SAll" Style="{StaticResource SeriesTab}" Tag="{StaticResource Ink}" Margin="0,0,-1,0" GroupName="Series" Content="All" Checked="Tab_Changed" AutomationProperties.Name="Donors: all series"/>
                            <RadioButton x:Name="SF1" Style="{StaticResource SeriesTab}" Tag="{StaticResource F1Red}" Margin="0,0,-1,0" GroupName="Series" Content="F1" IsChecked="True" Checked="Tab_Changed" AutomationProperties.Name="Donors: F1"/>
                            <RadioButton x:Name="SF2" Style="{StaticResource SeriesTab}" Tag="{StaticResource F2Blue}" GroupName="Series" Content="F2" Checked="Tab_Changed" AutomationProperties.Name="Donors: F2"/>
                        </StackPanel>
                    </StackPanel>
                    <local:Tracked x:Name="DonorLabel" Style="{StaticResource Label}" Text="Steering wheel from" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DonorHint" Style="{StaticResource Sub}" FontSize="11" Margin="14,0,14,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </DockPanel>
                <!-- search / team: any season and series at once -->
                <Grid x:Name="DonorFilter" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBox x:Name="DonorSearch" Height="30" TextChanged="Filter_Changed" AutomationProperties.Name="Donors: search"/>
                        <TextBlock x:Name="SearchHint" Text="search team, livery or year" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="11.5" Foreground="#A8A2B8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=DonorSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox x:Name="DonorTeam" Grid.Column="1" Width="196" Margin="10,0,0,0" SelectionChanged="Team_Changed" AutomationProperties.Name="Donors: team"/>
                </Grid>
                <!-- up to six rows of chips; longer lists scroll -->
                <ScrollViewer x:Name="DonorScroll" MaxHeight="216" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>
                    </ScrollViewer.Resources>
                    <ListBox x:Name="DonorBox" Style="{StaticResource Chips}" IsSynchronizedWithCurrentItem="False" SelectionChanged="Donor_Changed"
                             AutomationProperties.AutomationId="DonorBox"/>
                </ScrollViewer>
                <TextBlock x:Name="DonorEmpty" Style="{StaticResource Sub}" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Margin="0,0,0,12">
                <local:Tracked Style="{StaticResource Label}" Text="Save as"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Click="BrowseOut_Click"/>
                    <TextBox x:Name="OutBox"/>
                </DockPanel>
            </StackPanel>

            <WrapPanel Grid.Row="8" Margin="0,0,0,4">
                <Button x:Name="BuildButton" Style="{StaticResource Primary}" Margin="0,0,14,8" Content="Build .serps" Click="Build_Click"
                        ToolTip="Build and save the new .serps template"/>
                <Button x:Name="PopButton" Margin="0,0,14,8" Content="Pop out preview" Click="Pop_Click"
                        AutomationProperties.AutomationId="PopButton" ToolTip="The 3D preview in its own window (resizable, e.g. on another screen); close it to put it back"/>
                <CheckBox x:Name="ReportBox" Margin="4,0,18,8" VerticalAlignment="Center" AutomationProperties.Name="Save a report"
                          ToolTip="Also save an HTML page next to the new .serps with before/after pictures of the wheel, its textures and the checks">
                    <local:Tracked Text="Save a report" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="10.5" Tracking="0.14"/>
                </CheckBox>
                <CheckBox x:Name="PicturesBox" Margin="0,0,4,8" VerticalAlignment="Center" AutomationProperties.Name="Hover previews"
                          Checked="Pictures_Changed" Unchecked="Pictures_Changed"
                          ToolTip="A preview of each car, rim, steering wheel and suit when you hover it in the lists">
                    <local:Tracked Text="Hover previews" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="10.5" Tracking="0.14"/>
                </CheckBox>
                <!-- the note on how the previews are made: shown at once on hover, pinned open by a click (until a click elsewhere) -->
                <Button x:Name="PreviewsInfo" Margin="0,0,14,8" VerticalAlignment="Center" Cursor="Hand"
                        AutomationProperties.Name="About hover previews" AutomationProperties.HelpText="{Binding Text, ElementName=PreviewsNote}"
                        MouseEnter="PreviewsInfo_Enter" MouseLeave="PreviewsInfo_Leave" Click="PreviewsInfo_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- Material Symbols "info" (outlined, weight 400) by Google, Apache License 2.0 -->
                            <Border x:Name="Back" Width="18" Height="18" CornerRadius="9" Background="Transparent">
                                <Path x:Name="Mark" Width="14" Height="14" Stretch="Uniform" Fill="{StaticResource Purple}"
                                          Data="F1 M440,-280h80v-240h-80v240Zm68.5,-331.5Q520,-623 520,-640t-11.5,-28.5Q497,-680 480,-680t-28.5,11.5Q440,-657 440,-640t11.5,28.5Q463,-600 480,-600t28.5,-11.5ZM480,-80q-83,0 -156,-31.5T197,-197q-54,-54 -85.5,-127T80,-480q0,-83 31.5,-156T197,-763q54,-54 127,-85.5T480,-880q83,0 156,31.5T763,-763q54,54 85.5,127T880,-480q0,83 -31.5,156T763,-197q-54,54 -127,85.5T480,-80Zm0,-80q134,0 227,-93t93,-227q0,-134 -93,-227t-227,-93q-134,0 -227,93t-93,227q0,134 93,227t227,93Z"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource LineSoft}"/>
                                    <Setter TargetName="Mark" Property="Fill" Value="{StaticResource Deep}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource LineSoft}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="PreviewsProgress" Margin="0,0,14,8" VerticalAlignment="Center" Visibility="Collapsed"
                           FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Muted}"
                           AutomationProperties.AutomationId="PreviewsProgress"
                           ToolTip="The hover previews are being made in the background; the app works as usual meanwhile"/>
                <Popup x:Name="PreviewsPop" PlacementTarget="{Binding ElementName=PreviewsInfo}" Placement="Top" VerticalOffset="-6"
                       HorizontalOffset="-12" AllowsTransparency="True" StaysOpen="True">
                    <Border Background="{StaticResource Deep}" BorderBrush="{StaticResource Purple}" BorderThickness="1" Padding="14,11" MaxWidth="360">
                        <StackPanel>
                            <local:Tracked Text="Hover previews" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="10.5" Tracking="0.14"
                                           Foreground="White" Margin="0,0,0,6"/>
                            <TextBlock x:Name="PreviewsNote" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="19" Foreground="#E6E0F5"
                                       Text="Hover over any car, rim, wheel or suit in the lists to see what it looks like.&#10;&#10;The first time you open Swapper, these previews are made from your game in the background. It takes about a minute (longer on a slower PC), and you can keep using the app while it works. After that they appear instantly.&#10;&#10;On a slower PC? Untick Hover previews to skip this."/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="ReportButton" Margin="0,0,14,8" Content="Open report" Visibility="Collapsed" Click="Report_Click"
                        AutomationProperties.Name="Open report" ToolTip="Before/after pictures, textures and verification for this build"/>
                <Button x:Name="ShowButton" Margin="0,0,14,8" Content="Show in folder" Visibility="Collapsed" Click="Show_Click"/>
                <Border x:Name="StatusPill" Margin="0,0,14,8" Padding="10,6" VerticalAlignment="Center" Visibility="Collapsed" Background="{StaticResource Teal}">
                    <local:Tracked x:Name="StatusText" FontFamily="{StaticResource Display}" FontWeight="Heavy" FontSize="9.5" Tracking="0.14" Foreground="{StaticResource Ink}"/>
                </Border>
                <ProgressBar x:Name="Busy" Width="140" Height="4" Margin="0,0,14,8" IsIndeterminate="True" Visibility="Collapsed"
                             Background="{StaticResource LineSoft}" BorderThickness="0" Foreground="{StaticResource Purple}" VerticalAlignment="Center"/>
            </WrapPanel>

            <Border Grid.Row="9" Background="{StaticResource Deep}">
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource Mono}" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="8,8,2,8">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="{TemplateBinding Padding}"/></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" LineHeight="18"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- drag to make the preview bigger or smaller (the width is remembered; double-click resets) -->
        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      Background="Transparent" Cursor="SizeWE" Focusable="False" DragDelta="Splitter_DragDelta" DragCompleted="Splitter_DragCompleted" MouseDoubleClick="Splitter_DoubleClick"
                      AutomationProperties.AutomationId="Splitter" ToolTip="Drag to resize the preview · double-click to reset">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="line" Width="2" Margin="0,20,0,22" Background="{StaticResource Line}"/>
                        <Border x:Name="grip" Width="6" Height="46" Background="{StaticResource Line}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="line" Property="Background" Value="{StaticResource Purple}"/>
                            <Setter TargetName="grip" Property="Background" Value="{StaticResource Purple}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="line" Property="Background" Value="{StaticResource Purple}"/>
                            <Setter TargetName="grip" Property="Background" Value="{StaticResource Purple}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- the 3D preview: follows the picks; the page has its own controls (views, studio, before / after) -->
        <DockPanel x:Name="PreviewPanel" Grid.Column="2" Margin="4,20,26,22">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,9">
                <local:Tracked Style="{StaticResource Label}" Text="Preview" Margin="0" VerticalAlignment="Center"/>
                <ComboBox x:Name="PreviewEntry" Width="290" Margin="14,0,0,0" VerticalAlignment="Center" SelectionChanged="PreviewEntry_Changed"
                          AutomationProperties.AutomationId="PreviewEntry" ToolTip="What the preview shows: the new chassis option (while a chassis is picked) or one of the template's chassis options as it is"/>
                <TextBlock x:Name="PreviewStatus" Style="{StaticResource Sub}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="PreviewStatus"/>
            </DockPanel>
            <Border Background="#111111" BorderBrush="#2B2140" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="PreviewNote" Visibility="Collapsed" Margin="30" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="12.5" Foreground="#BFB2EA"/>
                    <wv2:WebView2 x:Name="PreviewView" DefaultBackgroundColor="#111111" AutomationProperties.AutomationId="PreviewView"/>
                </Grid>
            </Border>
        </DockPanel>
        </Grid>
    </Grid>
</Window>
