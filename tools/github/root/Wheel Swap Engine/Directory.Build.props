<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the RM Designs Studio shared engine (Studio.Core + EgoEngineLibrary), beside this folder -->
    <StudioShared>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'shared'))</StudioShared>
  </PropertyGroup>
</Project>
