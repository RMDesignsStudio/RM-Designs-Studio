<Application x:Class="HelmetSwap.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HelmetSwap.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Brand.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- RM Designs: fonts (embedded) and palette -->
            <FontFamily x:Key="Display">pack://application:,,,/Fonts/#Presicav</FontFamily>
            <FontFamily x:Key="Mono">pack://application:,,,/Fonts/#Roboto Mono</FontFamily>

            <SolidColorBrush x:Key="Ink" Color="#111111"/>
            <SolidColorBrush x:Key="Deep" Color="#1C0040"/>
            <SolidColorBrush x:Key="Purple" Color="#4300AD"/>
            <SolidColorBrush x:Key="PurpleHover" Color="#5512D1"/>
            <SolidColorBrush x:Key="Paper" Color="#F9F9F9"/>
            <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Line" Color="#D6D3DF"/>
            <SolidColorBrush x:Key="LineSoft" Color="#ECE9F2"/>
            <SolidColorBrush x:Key="Muted" Color="#6E6684"/>
            <SolidColorBrush x:Key="Teal" Color="#01FAC0"/>
            <SolidColorBrush x:Key="Magenta" Color="#FF1FCF"/>
            <SolidColorBrush x:Key="Amber" Color="#FFA000"/>
            <SolidColorBrush x:Key="Red" Color="#ED3000"/>
            <!-- series colours (from the F1 and F2 logos) -->
            <SolidColorBrush x:Key="F1Red" Color="#E10600"/>
            <SolidColorBrush x:Key="F2Blue" Color="#009CDE"/>
            <!-- log (on deep purple) -->
            <SolidColorBrush x:Key="LogText" Color="#E9E2FF"/>
            <SolidColorBrush x:Key="LogMuted" Color="#A99BD6"/>
            <SolidColorBrush x:Key="LogOk" Color="#01FAC0"/>
            <SolidColorBrush x:Key="LogWarn" Color="#FFB020"/>
            <SolidColorBrush x:Key="LogError" Color="#FF6A88"/>

            <local:TeamBrush x:Key="TeamBrush"/>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            </Style>
            <!-- section label: small wide caps -->
            <Style x:Key="Label" TargetType="local:Tracked">
                <Setter Property="FontFamily" Value="{StaticResource Display}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Tracking" Value="0.16"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <!-- lowercase mono subtext (Roboto Mono Bold) -->
            <Style x:Key="Sub" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource Purple}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource Panel}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="CaretBrush" Value="{StaticResource Purple}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource Purple}"/>
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Purple}"/></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Purple}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- square buttons with wide-caps text -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Panel}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="BorderBrush" Value="#CFCBD9"/>
                <Setter Property="FontFamily" Value="{StaticResource Display}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate><local:Tracked Text="{Binding}" Tracking="0.14" VerticalAlignment="Center"/></DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Purple}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource LineSoft}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource Purple}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Purple}"/>
                <Setter Property="Foreground" Value="{StaticResource Paper}"/>
                <Setter Property="FontWeight" Value="Heavy"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="30,0"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource PurpleHover}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Deep}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- square purple checkbox -->
            <!-- tooltips (the hover previews too) fade in, as Swapper's -->
            <Style TargetType="ToolTip">
                <Style.Triggers>
                    <Trigger Property="IsOpen" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard>
                        </Trigger.EnterActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="box" Width="17" Height="17" BorderBrush="{StaticResource Purple}" BorderThickness="1.5" Background="{StaticResource Panel}" VerticalAlignment="Center">
                                    <Path x:Name="tick" Data="M 2.2,7.2 L 5.6,10.4 L 12.2,3.4" Stroke="{StaticResource Paper}" StrokeThickness="2" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{StaticResource Purple}"/>
                                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource PurpleHover}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- team chips: single-select, square, in the team's colour -->
            <Style x:Key="Chips" TargetType="ListBox">
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,6,6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                            <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                            <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="chip" Background="{StaticResource Panel}" BorderBrush="#CFCBD9" BorderThickness="1" Height="30">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="bar" Width="5" Background="{Binding Id, Converter={StaticResource TeamBrush}}"/>
                                                <local:Tracked x:Name="t" Text="{Binding Name}" Margin="11,0,13,0" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="10" Tracking="0.12"
                                                               Foreground="{StaticResource Ink}"/>
                                                <!-- helmet make, lowercase mono (driver chips only) -->
                                                <TextBlock x:Name="make" Text="{Binding Make}" Margin="-5,1,12,0" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Muted}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Purple}"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="chip" Property="Background" Value="{Binding Id, Converter={StaticResource TeamBrush}}"/>
                                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Ink}"/>
                                                <Setter TargetName="chip" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="bar" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="t" Property="Margin" Value="15,0,12,0"/>
                                                <Setter TargetName="t" Property="FontWeight" Value="Heavy"/>
                                                <Setter TargetName="t" Property="Foreground" Value="{Binding Id, Converter={StaticResource TeamBrush}, ConverterParameter=text}"/>
                                                <Setter TargetName="make" Property="Foreground" Value="{Binding Id, Converter={StaticResource TeamBrush}, ConverterParameter=text}"/>
                                                <Setter TargetName="make" Property="Opacity" Value="0.75"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                                            <!-- a helmet some part already comes from (parts from several helmets) -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Used}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource Purple}"/>
                                                <Setter TargetName="chip" Property="BorderThickness" Value="2"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- a part slot (Parts row): the part and whose it is; checked = the next helmet picked goes here -->
            <Style x:Key="PartSlot" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="#CFCBD9" BorderThickness="1" Padding="11,5,26,6" MinWidth="122">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Purple}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Purple}"/>
                                    <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="b" Property="Padding" Value="10,4,25,5"/>
                                    <Setter TargetName="b" Property="Background" Value="#EFE8FF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- the small x on a slot: the part goes back to the driver's own -->
            <Style x:Key="SlotClear" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" Width="20" Height="20">
                                <TextBlock x:Name="x" Text="✕" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="x" Property="Foreground" Value="{StaticResource Red}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- F1 / F2 series tabs: small square segmented toggle; Tag = the series colour -->
            <Style x:Key="SeriesTab" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="#CFCBD9" BorderThickness="1" Height="24" Padding="11,0">
                                <local:Tracked x:Name="t" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" FontFamily="{StaticResource Display}"
                                               FontWeight="Heavy" FontSize="9.5" Tracking="0.14" Foreground="{StaticResource Muted}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Setter TargetName="t" Property="Foreground" Value="{StaticResource Paper}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Panel.ZIndex" Value="1"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Panel.ZIndex" Value="2"/></Trigger>
                </Style.Triggers>
            </Style>

            <!-- slim scrollbar for the log -->
            <Style x:Key="SlimThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb"><Border Background="#5B3E9A" Margin="3,2"/></ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SlimScroll" TargetType="ScrollBar">
                <Setter Property="Width" Value="12"/>
                <Setter Property="MinWidth" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb><Thumb Style="{StaticResource SlimThumb}"/></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- square dropdown (team filter) -->
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="b" Background="{StaticResource Panel}" BorderBrush="#CFCBD9" BorderThickness="1">
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource Purple}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Purple}"/></Trigger>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Purple}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False" Margin="10,0,28,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Purple}" BorderThickness="1" MaxHeight="340"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/></ScrollViewer.Resources>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="b" Padding="10,6" Background="Transparent"><ContentPresenter/></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#E6DEFA"/></Trigger>
                                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource LineSoft}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
