<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the RM Designs Studio shared folder (the Studio window look, Studio.Ui), beside this app's folder in RM Designs Studio -->
    <StudioShared>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'shared'))</StudioShared>
  </PropertyGroup>
</Project>
